datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Booking {
  id             String   @id @default(cuid())
  bookingRef     String   @unique
  customerName   String
  phone          String
  pickupCity     String
  dropoffCity    String
  pickupLocation String?
  date           String
  time           String
  returnDate     String?
  returnTime     String?
  carType        String
  passengers     Int      @default(1)
  serviceType    String   @default("Airport Transfer")
  paymentMethod  String   @default("Cash")
  status         String   @default("confirmed") // confirmed, pending, in_progress, completed, cancelled
  amount         Float    @default(0)
  notes          String?
  
  driverId       String?
  driver         Driver?  @relation(fields: [driverId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bookingRef])
  @@index([phone])
  @@index([status])
}

model Driver {
  id        String    @id @default(cuid())
  name      String
  phone     String
  rating    Float     @default(5.0)
  vehicle   String
  plate     String
  avatar    String?
  status    String    @default("active") // active, off_duty
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int      @default(5)
  date      String
  comment   String
  route     String
  country   String?
  status    String   @default("approved") // approved, pending, rejected
  createdAt DateTime @default(now())

  @@index([status])
}

model ContactInquiry {
  id         String   @id @default(cuid())
  inquiryRef String   @unique
  fullName   String
  email      String
  phone      String
  subject    String?
  message    String
  status     String   @default("unread") // unread, read, replied
  createdAt  DateTime @default(now())

  @@index([status])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  format    String?
  bytes     Int?
  folder    String?
  createdAt DateTime @default(now())
}
